# ─────────────────────────────────────────────────────────────────────────────
# rgstr — example configuration
# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

# Address and port to listen on.
# Examples: ":5000"  "0.0.0.0:5000"  "127.0.0.1:5000"
RGSTR_ADDR=:5000

# Directory holding blobs, manifests and upload sessions.
# With docker compose this is overridden to /data (the volume mount).
RGSTR_STORAGE=./data


# ── TLS (optional) ────────────────────────────────────────────────────────────

# When both are set, the server runs HTTPS.
# Leave empty for HTTP (e.g. behind nginx or Caddy).
RGSTR_TLS_CERT=
RGSTR_TLS_KEY=


# ── Authentication ────────────────────────────────────────────────────────────

# Turn on Bearer token authentication.
# false — the registry is open (fine for local development).
# true  — every request needs a valid JWT.
RGSTR_AUTH_ENABLED=false

# Secret for signing JWTs (HMAC-SHA256).
# Generate one: openssl rand -hex 32
# CHANGE IT before running in production!
RGSTR_AUTH_SECRET=change-me-in-production

# Full URL of the token endpoint. Docker clients get it from the
# WWW-Authenticate header and fetch a token on docker login / push / pull.
# Clients must reach it: use the server's external address.
RGSTR_AUTH_REALM=http://localhost:5000/v2/auth

# Service name in tokens (the "aud" claim). Must match what clients send
# in ?service= when they ask for a token.
RGSTR_AUTH_SERVICE=rgstr

# Token issuer (the "iss" claim). Any string.
RGSTR_AUTH_ISSUER=rgstr

# Lifetime of issued tokens.
# Format: 30s, 15m, 1h, 24h
RGSTR_TOKEN_TTL=1h

# How long a web admin session lasts without activity. While the admin is
# open, the session is extended; signing out ends it on the server.
RGSTR_SESSION_TTL=12h

# Users as 'name:bcrypt-hash,name:bcrypt-hash'.
# To make a hash (no Go needed):
#   docker run --rm --entrypoint /mkpasswd ghcr.io/piqab/rgstr alice mypassword
# or from source: go run ./cmd/mkpasswd alice mypassword
#
# IMPORTANT: put the value in SINGLE quotes. Bcrypt hashes contain $, and
# without quotes (or in double quotes) docker compose substitutes variables
# for them — the hash gets cut and sign-in stops working.
# Example:
#   RGSTR_USERS='alice:$2a$10$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXYZ01234,bob:$2a$10$...'

RGSTR_USERS=

# First administrator with a plain password — handy for the first start, no
# hash needed. This password only lets you sign in to the web admin (/ui)
# and change it: docker login with it is refused. The new password is
# stored as a bcrypt hash in <RGSTR_STORAGE>/users.json (in Docker, on the
# /data volume). This user is always an administrator (may delete).
#
# Forgot the password? Set a different RGSTR_ADMIN_PASSWORD here and
# restart: the stored password is reset, and the new one must be changed
# again at sign-in.
RGSTR_ADMIN_USER=admin
RGSTR_ADMIN_PASSWORD=

# User roles (names from RGSTR_USERS, comma-separated).
#   RGSTR_ADMINS          — may delete tags and blobs. When empty, every
#                           user except read-only ones may delete.
#   RGSTR_READONLY_USERS  — pull only.
# Other users from RGSTR_USERS may pull and push.
# Example:
#   RGSTR_ADMINS=alice
#   RGSTR_READONLY_USERS=ci-reader,viewer
RGSTR_ADMINS=
RGSTR_READONLY_USERS=

# ── Client addresses ──────────────────────────────────────────────────────────

# Which proxies to believe in X-Forwarded-For (CIDRs or IPs, comma-separated).
# The client IP goes into the audit log (/data/audit.log) and is used by
# fail2ban. The header counts only when the request comes from one of these
# addresses; otherwise a client could claim any IP.
#   empty — loopback and private networks (nginx on the host or in Docker)
#   none  — never believe the header (the registry is reached directly)
# Example: RGSTR_TRUSTED_PROXIES=10.0.0.5,172.18.0.0/16
RGSTR_TRUSTED_PROXIES=

# ── Public repositories ───────────────────────────────────────────────────────

# Patterns of repositories anyone may pull without signing in.
# Push always needs authentication, whatever this says.
#
# Patterns:
#   *          — any single path segment (no slashes)
#   **         — any path, slashes included
#   ?          — any single character
#
# Examples:
#   *                    — every repository is public (an open pull registry)
#   public/**            — everything under "public/" without signing in
#   library/ubuntu       — just this repository
#   library/*            — every repository directly under "library/"
#
# Leave empty to keep every repository private.
# Ignored when RGSTR_AUTH_ENABLED=false.
RGSTR_PUBLIC_REPOS=


# ── Metrics ───────────────────────────────────────────────────────────────────

# Prometheus metrics at /metrics (no authentication — for the monitoring
# network only).
RGSTR_METRICS_ENABLED=false


# ── Cluster (optional) ────────────────────────────────────────────────────────
# Several rgstr processes on S3 and PostgreSQL: see README, "Cluster (HA)".

# RGSTR_DATABASE_URL=postgres://rgstr:secret@db:5432/rgstr?sslmode=require
# RGSTR_STORAGE_DRIVER=s3
# RGSTR_STORAGE_S3_BUCKET=registry
# RGSTR_STORAGE_S3_ENDPOINT=https://storage.yandexcloud.net
# RGSTR_STORAGE_S3_REGION=ru-central1
# RGSTR_STORAGE_S3_ACCESS_KEY=
# RGSTR_STORAGE_S3_SECRET_KEY=
# RGSTR_STORAGE_S3_REDIRECT=false

# ── Backups (optional) ────────────────────────────────────────────────────────
# Scheduled backups of all data to S3 or a directory; restore with
# rgstr restore latest (with rgstr stopped). See README, "Backups".

# RGSTR_BACKUP_TARGET=s3://my-backups/rgstr
# RGSTR_BACKUP_SCHEDULE=0 3 * * *
# RGSTR_BACKUP_KEEP=7
# RGSTR_BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
# RGSTR_BACKUP_S3_REGION=ru-central1
# RGSTR_BACKUP_S3_ACCESS_KEY=
# RGSTR_BACKUP_S3_SECRET_KEY=

# ── LDAP / Active Directory (optional) ────────────────────────────────────────
# Sign-in with directory passwords (docker login and the web admin). Details
# and examples for AD and OpenLDAP: README, "LDAP and Active Directory".

# RGSTR_LDAP_URL=ldaps://dc1.corp.example:636
# RGSTR_LDAP_BIND_DN='CN=svc-rgstr,OU=Service,DC=corp,DC=example'
# RGSTR_LDAP_BIND_PASSWORD=
# RGSTR_LDAP_BASE_DN='DC=corp,DC=example'
# RGSTR_LDAP_USER_FILTER='(&(objectClass=user)(sAMAccountName=%s))'
# RGSTR_LDAP_ADMIN_GROUPS=Registry-Admins
# RGSTR_LDAP_READONLY_GROUPS=
# RGSTR_LDAP_ALLOWED_GROUPS=
# RGSTR_LDAP_DEFAULT_ROLE=user


# ── Single sign-on, OpenID Connect (optional) ─────────────────────────────────
# A "Sign in with …" button in the web admin. For docker login, SSO users
# make a CLI secret in the admin. Redirect URL to register at the provider:
#   https://<registry>/ui/oidc/callback

# RGSTR_OIDC_ISSUER=https://sso.example.com/realms/main
# RGSTR_OIDC_CLIENT_ID=rgstr
# RGSTR_OIDC_CLIENT_SECRET=
# RGSTR_OIDC_NAME=Keycloak
# RGSTR_OIDC_ADMIN_GROUPS=registry-admins
# RGSTR_OIDC_READONLY_GROUPS=
# RGSTR_OIDC_ALLOWED_GROUPS=


# ── Garbage collection ────────────────────────────────────────────────────────

# How often garbage collection runs.
# GC removes images no tag points to (manifests and their blobs, unless other
# images need them) and stale upload sessions older than RGSTR_UPLOAD_TTL.
# Format: 30m, 1h, 6h, 24h
RGSTR_GC_INTERVAL=1h

# Maximum lifetime of an unfinished upload session; older sessions are
# removed by the next GC run.
# This is also the GC grace period: recently uploaded blobs and manifests are
# kept even if no tag points to them yet, so GC never breaks a push in
# progress. The data of a deleted image leaves the disk no sooner than this
# long after it was uploaded.
# Format: 1h, 12h, 24h, 168h
RGSTR_UPLOAD_TTL=24h
