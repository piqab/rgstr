# ─────────────────────────────────────────────────────────────────────────────
# rgstr — пример конфигурации
# Скопируйте этот файл в .env и заполните нужные значения:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Сервер ────────────────────────────────────────────────────────────────────

# Адрес и порт для прослушивания.
# Примеры: ":5000"  "0.0.0.0:5000"  "127.0.0.1:5000"
RGSTR_ADDR=:5000

# Путь к директории, где хранятся blob'ы, манифесты и upload-сессии.
# При запуске через docker-compose это значение перезаписывается на /data (volume mount).
RGSTR_STORAGE=./data


# ── TLS (опционально) ─────────────────────────────────────────────────────────

# Если оба параметра заданы — сервер запускается в режиме HTTPS.
# Оставьте пустыми для HTTP (например, за nginx/Caddy).
RGSTR_TLS_CERT=
RGSTR_TLS_KEY=


# ── Аутентификация ────────────────────────────────────────────────────────────

# Включить Bearer token аутентификацию.
# false — реестр открытый (подходит для локальной разработки).
# true  — все запросы требуют валидного JWT токена.
RGSTR_AUTH_ENABLED=false

# Секрет для подписи JWT (HMAC-SHA256).
# Генерация: openssl rand -hex 32
# ОБЯЗАТЕЛЬНО смените перед запуском в production!
RGSTR_AUTH_SECRET=change-me-in-production

# Полный URL токен-эндпоинта. Docker-клиент получает его из WWW-Authenticate
# заголовка и автоматически идёт за токеном при docker login / push / pull.
# Должен быть доступен клиенту извне — укажите внешний адрес сервера.
RGSTR_AUTH_REALM=http://localhost:5000/v2/auth

# Имя сервиса в токенах (поле "aud"). Должно совпадать с тем, что
# передаёт клиент в параметре ?service= при запросе токена.
RGSTR_AUTH_SERVICE=rgstr

# Издатель токенов (поле "iss"). Произвольная строка.
RGSTR_AUTH_ISSUER=rgstr

# Время жизни выданного токена.
# Формат: 30s, 15m, 1h, 24h
RGSTR_TOKEN_TTL=1h

# Сколько живёт сессия веб-админки без активности. Пока админка открыта,
# сессия продлевается; выход завершает её на сервере.
RGSTR_SESSION_TTL=12h

# Список пользователей в формате 'имя:bcrypt-хеш,имя:bcrypt-хеш'.
# Для генерации хеша (Go не нужен):
#   docker run --rm --entrypoint /mkpasswd ghcr.io/piqab/rgstr alice mypassword
# или из исходников: go run ./cmd/mkpasswd alice mypassword
#
# ВАЖНО: значение берите в ОДИНАРНЫЕ кавычки. Bcrypt-хеш содержит символы $,
# и без кавычек (или в двойных) docker compose подставит вместо них
# переменные — хеш обрежется, и вход перестанет работать.
# Пример:
#   RGSTR_USERS='alice:$2a$10$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXYZ01234,bob:$2a$10$...'

RGSTR_USERS=

# Первый администратор с простым паролем — удобно для первого запуска, хеш
# генерировать не нужно. С этим паролем можно только войти в веб-интерфейс
# (/ui) и сменить его: docker login с ним отклоняется. Новый пароль хранится
# в виде bcrypt-хеша в <RGSTR_STORAGE>/users.json (в Docker — на томе /data).
# Этот пользователь всегда администратор (может удалять).
#
# Забыли пароль — задайте здесь другой RGSTR_ADMIN_PASSWORD и перезапустите:
# сохранённый пароль сбросится, новый снова потребует смены при входе.
RGSTR_ADMIN_USER=admin
RGSTR_ADMIN_PASSWORD=

# Роли пользователей (имена из RGSTR_USERS через запятую).
#   RGSTR_ADMINS          — могут удалять теги и blob'ы. Если пусто, удалять
#                           могут все пользователи, кроме read-only.
#   RGSTR_READONLY_USERS  — только pull.
# Остальные пользователи из RGSTR_USERS могут pull и push.
# Пример:
#   RGSTR_ADMINS=alice
#   RGSTR_READONLY_USERS=ci-reader,viewer
RGSTR_ADMINS=
RGSTR_READONLY_USERS=

# ── Адреса клиентов ───────────────────────────────────────────────────────────

# Каким прокси верить в заголовке X-Forwarded-For (CIDR или IP через запятую).
# IP клиента пишется в журнал (/data/audit.log) и используется fail2ban.
# Заголовок учитывается, только если запрос пришёл с одного из этих адресов,
# иначе клиент мог бы подставить любой IP.
#   пусто — loopback и частные сети (nginx на хосте или в Docker)
#   none  — никогда не верить заголовку (реестр доступен напрямую)
# Пример: RGSTR_TRUSTED_PROXIES=10.0.0.5,172.18.0.0/16
RGSTR_TRUSTED_PROXIES=

# ── Публичные репозитории ─────────────────────────────────────────────────────

# Список паттернов репозиториев, доступных для pull без аутентификации.
# Push всегда требует авторизации, независимо от этой настройки.
#
# Поддерживаемые паттерны:
#   *          — любой одиночный сегмент (без слешей)
#   **         — любой путь, включая слеши
#   ?          — любой одиночный символ
#
# Примеры:
#   *                    — все репозитории публичные (открытый реестр для pull)
#   public/**            — всё в namespace "public/" доступно без авторизации
#   library/ubuntu       — только конкретный репозиторий
#   library/*            — все репозитории в namespace "library/"
#
# Оставьте пустым, если все репозитории приватные.
# Если RGSTR_AUTH_ENABLED=false, эта настройка игнорируется.
RGSTR_PUBLIC_REPOS=


# ── Метрики ───────────────────────────────────────────────────────────────────

# Метрики Prometheus на /metrics (без авторизации — только для сети мониторинга).
RGSTR_METRICS_ENABLED=false


# ── LDAP / Active Directory (опционально) ─────────────────────────────────────
# Вход по паролю из каталога (docker login и веб-админка). Подробности и
# примеры для AD и OpenLDAP — в README, раздел «LDAP и Active Directory».

# RGSTR_LDAP_URL=ldaps://dc1.corp.example:636
# RGSTR_LDAP_BIND_DN='CN=svc-rgstr,OU=Service,DC=corp,DC=example'
# RGSTR_LDAP_BIND_PASSWORD=
# RGSTR_LDAP_BASE_DN='DC=corp,DC=example'
# RGSTR_LDAP_USER_FILTER='(&(objectClass=user)(sAMAccountName=%s))'
# RGSTR_LDAP_ADMIN_GROUPS=Registry-Admins
# RGSTR_LDAP_READONLY_GROUPS=
# RGSTR_LDAP_ALLOWED_GROUPS=
# RGSTR_LDAP_DEFAULT_ROLE=user


# ── Единый вход, OpenID Connect (опционально) ────────────────────────────────
# Кнопка «Войти через …» в веб-админке. Для docker login пользователи SSO
# создают CLI-секрет в админке. Адрес возврата у провайдера:
#   https://<реестр>/ui/oidc/callback

# RGSTR_OIDC_ISSUER=https://sso.example.com/realms/main
# RGSTR_OIDC_CLIENT_ID=rgstr
# RGSTR_OIDC_CLIENT_SECRET=
# RGSTR_OIDC_NAME=Keycloak
# RGSTR_OIDC_ADMIN_GROUPS=registry-admins
# RGSTR_OIDC_READONLY_GROUPS=
# RGSTR_OIDC_ALLOWED_GROUPS=


# ── Garbage Collection ────────────────────────────────────────────────────────

# Как часто запускать сборщик мусора.
# GC удаляет образы, на которые не указывает ни один тег (манифесты и их
# blob'ы, если те не нужны другим образам), а также зависшие upload-сессии
# старше RGSTR_UPLOAD_TTL.
# Формат: 30m, 1h, 6h, 24h
RGSTR_GC_INTERVAL=1h

# Максимальное время жизни незавершённой upload-сессии.
# Сессии старше этого значения будут удалены при следующем запуске GC.
# Это же льготный период GC: недавно загруженные blob'ы и манифесты не
# удаляются, даже если на них ещё не указывает тег, — чтобы GC не сломал
# push, идущий в момент запуска. Данные удалённого образа исчезают с диска
# не раньше, чем через этот срок после загрузки.
# Формат: 1h, 12h, 24h, 168h
RGSTR_UPLOAD_TTL=24h
